// Modelo de dados visto pelo backend VINEXT.
//
// UM SCHEMA, DOIS BACKENDS, UM DONO DAS MIGRATIONS
// ------------------------------------------------
// Os dois backends leem e escrevem nas MESMAS tabelas, no schema `sabemi`. E o
// que permite trocar de backend sem perder os dados nem refazer o login: os
// dois enxergam os mesmos pagamentos e os mesmos usuarios.
//
// Mas apenas UM pode ser dono das migrations. Se os dois migrassem, cada
// ferramenta veria as tabelas criadas pela outra como deriva a corrigir e
// tentaria destrui-las. O EF Core e o dono; este arquivo DESCREVE o mesmo
// modelo para o Prisma Client saber consultar, e nao gera migration alguma.
//
// COMO A DIVERGENCIA E IMPEDIDA
// -----------------------------
// `pnpm db:check` (e o CI) roda `prisma migrate diff` entre este arquivo e o
// banco real migrado pelo EF Core. Qualquer diferenca falha - o alinhamento nao
// depende de ninguem lembrar de atualizar os dois lados.
//
// Os tipos abaixo espelham exatamente o que o EF Core cria: `uuid` para
// identificadores, `varchar` para os estados (e nao enum nativo - o EF grava
// texto, o que deixa o valor legivel em consulta ad hoc), `numeric(18,2)` para
// dinheiro e `jsonb` para o payload bruto.

// O cliente e gerado DENTRO do projeto, e nao em `node_modules/.prisma`.
//
// Dois motivos. O primeiro e pratico: com pnpm, o node_modules e estrito e o
// cliente gerado ali nao consegue resolver o proprio runtime - falha no
// primeiro import. O segundo e que esta passou a ser a recomendacao do Prisma 7:
// o cliente e artefato do projeto e nao deve depender do layout interno do
// gerenciador de pacotes.
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// A URL de conexao NAO fica aqui. No Prisma 7 ela vive em `prisma.config.ts`
// e chega ao cliente por um adapter explicito (`server/bff/db.ts`).
datasource db {
  provider = "postgresql"
  schemas  = ["sabemi"]
}

/// Log de eventos brutos - uma linha por notificacao recebida.
///
/// `idTransacao` e unico: a idempotencia e garantida pelo indice do banco, nao
/// por verificacao em memoria. Duas reentregas simultaneas produzem uma
/// insercao e um erro P2002, que o servico traduz em "duplicado".
model PaymentEvent {
  id String @id(map: "PK_payment_events") @db.Uuid

  /// Chave de idempotencia vinda do banco parceiro.
  idTransacao String @unique(map: "ux_payment_events_id_transacao") @map("id_transacao") @db.VarChar(128)

  /// Anulaveis porque um payload invalido tambem e persistido - e pode nao
  /// trazer estes campos.
  idContrato    String?   @map("id_contrato") @db.VarChar(128)
  valor         Decimal?  @db.Decimal(18, 2)
  dataPagamento DateTime? @map("data_pagamento") @db.Timestamptz(6)
  statusOrigem  String?   @map("status_origem") @db.VarChar(32)

  /// Um de: PENDENTE, PROCESSANDO, SUCESSO, ERRO, INVALIDO, DUPLICADO.
  ///
  /// Guardado como texto, e nao como enum nativo: e assim que o EF Core grava,
  /// o valor fica legivel em consulta direta, e reordenar os membros do enum no
  /// codigo deixa de corromper dados existentes. O tipo forte fica no
  /// TypeScript (`ProcessingStatus`, em lib/contracts.ts).
  statusProcessamento String @map("status_processamento") @db.VarChar(16)

  /// Motivo da reprovacao na validacao ou da falha no processamento - a
  /// mensagem crua, tal como veio da excecao.
  erro String?

  /// Natureza da falha: TRANSITORIA, PERMANENTE ou DESCONHECIDA. E o que decide
  /// se o retry automatico faz sentido.
  erroCategoria String? @map("erro_categoria") @db.VarChar(16)

  /// Codigo estavel da causa (DEADLOCK, REFERENCIA_INEXISTENTE...). A
  /// explicacao e a acao sugeridas NAO sao gravadas: derivam deste codigo em
  /// server/bff/failure-catalog.ts, entao melhorar um texto do tooltip nao
  /// exige tocar em linha nenhuma da tabela.
  erroCodigo String? @map("erro_codigo") @db.VarChar(48)

  /// Corpo exatamente como chegou, para auditoria e eventual reprocessamento.
  payloadBruto Json @map("payload_bruto")

  assinaturaVerificada Boolean @map("assinatura_verificada")

  recebidoEm   DateTime  @map("recebido_em") @db.Timestamptz(6)
  processadoEm DateTime? @map("processado_em") @db.Timestamptz(6)
  tentativas   Int

  job ProcessingJob?

  @@index([idContrato], map: "ix_payment_events_id_contrato")
  @@index([statusProcessamento, recebidoEm], map: "ix_payment_events_status_recebido")
  /// Indice PARCIAL no banco (`WHERE erro_categoria IS NOT NULL`) - o Prisma nao
  /// tem sintaxe para o filtro, entao ele o descreve sem. Quem cria o indice e o
  /// EF Core; aqui e apenas descricao, e o `prisma migrate diff` do CI aceita a
  /// diferenca porque compara o modelo com o banco, nao com o outro schema.
  @@index([erroCategoria], map: "ix_payment_events_erro_categoria")
  @@map("payment_events")
  @@schema("sabemi")
}

/// Estado consolidado de um contrato. Chave primaria e o proprio id de negocio.
model ContractStatus {
  idContrato String @id(map: "PK_contract_statuses") @map("id_contrato") @db.VarChar(128)

  valorTotalLiquidado   Decimal   @map("valor_total_liquidado") @db.Decimal(18, 2)
  pagamentosConfirmados Int       @map("pagamentos_confirmados")
  ultimoPagamentoEm     DateTime? @map("ultimo_pagamento_em") @db.Timestamptz(6)
  ultimaTransacao       String?   @map("ultima_transacao") @db.VarChar(128)

  /// Um de: ATIVO, LIQUIDADO, INADIMPLENTE.
  situacao     String   @db.VarChar(16)
  atualizadoEm DateTime @map("atualizado_em") @db.Timestamptz(6)

  @@map("contract_statuses")
  @@schema("sabemi")
}

/// Fila durable de processamento.
///
/// O evento e o job sao gravados na mesma transacao, e o consumo usa
/// `FOR UPDATE SKIP LOCKED`. E o que impede o trabalho de sumir se o processo
/// cair entre o "202 Accepted" e o fim do processamento - um `setTimeout` nao
/// daria essa garantia.
model ProcessingJob {
  id String @id(map: "PK_processing_jobs") @db.Uuid

  /// Um job por evento.
  paymentEventId String       @unique(map: "ux_processing_jobs_payment_event_id") @map("payment_event_id") @db.Uuid
  paymentEvent   PaymentEvent @relation(fields: [paymentEventId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_processing_jobs_payment_events_payment_event_id")

  /// Um de: PENDENTE, PROCESSANDO, CONCLUIDO, FALHOU.
  estado        String @db.VarChar(16)
  tentativas    Int
  maxTentativas Int    @map("max_tentativas")

  /// Implementa o backoff: uma falha empurra esta data para frente.
  disponivelEm DateTime @map("disponivel_em") @db.Timestamptz(6)

  /// Quando o lease expira sem conclusao, um varredor devolve o item a fila.
  reivindicadoEm  DateTime? @map("reivindicado_em") @db.Timestamptz(6)
  reivindicadoPor String?   @map("reivindicado_por") @db.VarChar(128)

  ultimoErro String? @map("ultimo_erro")

  criadoEm     DateTime @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime @map("atualizado_em") @db.Timestamptz(6)

  @@index([estado, disponivelEm], map: "ix_processing_jobs_estado_disponivel")
  @@map("processing_jobs")
  @@schema("sabemi")
}

/// Pedido de login passwordless com confirmacao cross-device por polling.
///
/// `selector` e publico e viaja em cada consulta do polling; os segredos
/// (magic link e OTP) sao guardados apenas como hash SHA-256, entao um
/// vazamento do banco nao entrega logins ativos.
model LoginRequest {
  id String @id(map: "PK_login_requests") @db.Uuid

  /// Identificador publico usado no polling.
  selector String @unique(map: "ux_login_requests_selector") @db.VarChar(64)

  /// SHA-256 do token do link. Aberto em qualquer dispositivo.
  magicTokenHash String? @unique(map: "ux_login_requests_magic_token_hash") @map("magic_token_hash") @db.VarChar(64)

  /// SHA-256 do codigo de 6 digitos.
  otpCodeHash String? @map("otp_code_hash") @db.VarChar(64)

  otpTentativas Int @map("otp_tentativas")

  email String @db.VarChar(255)

  /// Um de: PENDENTE, APROVADO.
  status String @db.VarChar(16)

  criadoEm DateTime @map("criado_em") @db.Timestamptz(6)
  expiraEm DateTime @map("expira_em") @db.Timestamptz(6)

  @@index([email], map: "ix_login_requests_email")
  @@index([expiraEm], map: "ix_login_requests_expira_em")
  @@map("login_requests")
  @@schema("sabemi")
}

/// Operador do painel. Sem senha: o primeiro login cria a conta.
///
/// Compartilhado pelos dois backends - e por isso que a troca de backend nao
/// exige refazer o login.
model AppUser {
  id       String   @id(map: "PK_users") @db.Uuid
  email    String   @unique(map: "ux_users_email") @db.VarChar(255)
  criadoEm DateTime @map("criado_em") @db.Timestamptz(6)

  @@map("users")
  @@schema("sabemi")
}

/// Controle de versao das migrations do EF Core.
///
/// Nao e usada pelo backend VINEXT. Esta declarada porque `prisma migrate diff`
/// compara este arquivo com o banco INTEIRO - omiti-la apareceria como
/// divergencia a cada verificacao, e o alarme viraria ruido.
model EFMigrationsHistory {
  migrationId    String @id(map: "PK___EFMigrationsHistory") @map("MigrationId") @db.VarChar(150)
  productVersion String @map("ProductVersion") @db.VarChar(32)

  @@map("__EFMigrationsHistory")
  @@schema("sabemi")
}
