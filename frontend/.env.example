# Modelo de ambiente.  cp .env.example .env
#
# Frontend VINEXT e backend alternativo (BFF), rodando FORA do Docker.
# No compose estas variáveis vêm do docker-compose.yml e do .env da raiz.
#
# Só está aqui o que é segredo ou muda entre máquinas. Tamanho de lote,
# tentativas e timeouts têm default no código (server/bff/config.ts).
#
# Nenhuma pode receber NEXT_PUBLIC_: são segredos e configuração de servidor.

# Mesma conexão do backend .NET. Suba com: docker compose up -d postgres
DATABASE_URL="postgresql://sabemi_app:sabemi@localhost:5432/postgres"

# Como o SERVIDOR do VINEXT alcança a API .NET. No compose vira http://api:8080
DOTNET_API_URL="http://localhost:8080"

# `local` (magic link próprio) ou `supabase` (GoTrue emite, envia e valida).
AUTH_PROVIDER="local"

# Precisa ser IGUAL ao Jwt:Secret da API .NET. Mínimo 32 caracteres.
JWT_SECRET="troque-este-segredo-em-producao-com-no-minimo-32-caracteres"

# Base do link de confirmação. Para testar cross-device na LAN, use seu IP.
BFF_PUBLIC_BASE_URL="http://localhost:3000"

# Só usadas quando AUTH_PROVIDER=supabase.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

# Chave da API v3 (xkeysib-...). Vazio = link de acesso vai só para o log.
BREVO_API_KEY=""

# Os mesmos valores da API .NET: o parceiro entrega em qualquer um dos dois.
WEBHOOK_API_KEY="sabemi-dev-api-key"
WEBHOOK_SIGNATURE_SECRET="sabemi-dev-signature-secret"

# Liga o tracing. Vazio = só métricas, em :9464/metrics.
OTEL_EXPORTER_OTLP_ENDPOINT=""
