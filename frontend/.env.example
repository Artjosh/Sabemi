# Ambiente do frontend VINEXT e do backend alternativo (BFF).
#
#   cp .env.example .env
#
# Usado apenas no desenvolvimento local, fora do Docker. No compose, estas
# variaveis vem de `docker-compose.yml` e do `.env` da raiz do repositorio.
#
# Nenhuma delas pode receber o prefixo NEXT_PUBLIC_: sao segredos e configuracao
# de servidor, e o prefixo publico as empacotaria no bundle do browser.

# ---------------------------------------------------------------- banco
# Os DOIS backends compartilham o schema `sabemi` - e o que faz o mesmo dado
# aparecer nos dois, sem novo login ao trocar de backend.
#
# NAO acrescente `?schema=` aqui. O Prisma qualifica cada tabela pelo `@@schema`
# do modelo, entao o parametro e desnecessario - e o driver `pg` o interpretava
# como o USUARIO da conexao, fazendo o backend falhar com
# `password authentication failed for user "sabemi"`.
#
# Suba o PostgreSQL com:  docker compose up -d postgres
DATABASE_URL="postgresql://sabemi_app:sabemi@localhost:5432/sabemi"

# ------------------------------------------------------- backend primario
# Como o SERVIDOR do VINEXT alcanca a API .NET. Localhost aqui porque, em
# desenvolvimento, os dois rodam na mesma maquina; no compose vira o nome do
# serviço (http://api:8080).
DOTNET_API_URL="http://localhost:8080"

# ---------------------------------------------------------------- sessao
# Precisa ser IGUAL ao Jwt:Secret da API .NET: e o que permite ao gateway
# aceitar uma sessao emitida por qualquer um dos dois backends. Minimo de 32
# caracteres.
JWT_SECRET="troque-este-segredo-em-producao-com-no-minimo-32-caracteres"

# ------------------------------------------------- seguranca do webhook
# Os mesmos valores da API .NET, para que o banco parceiro possa entregar em
# qualquer um dos dois backends com as mesmas credenciais.
WEBHOOK_API_KEY="sabemi-dev-api-key"
WEBHOOK_SIGNATURE_SECRET="sabemi-dev-signature-secret"
WEBHOOK_REQUIRE_SIGNATURE="false"

# ---------------------------------------------------------- link de acesso
# Base publica usada para montar o link de confirmacao do e-mail. Precisa ser
# alcancavel pelo NAVEGADOR - inclusive de outro aparelho, se voce for testar o
# fluxo cross-device na rede local (troque por http://<seu-ip>:3000).
BFF_PUBLIC_BASE_URL="http://localhost:3000"

# -------------------------------------------------------- processamento
# A regra pesada simulada exigida pela task. E este o tempo que o webhook NAO
# paga: ele responde antes, e o processamento acontece em background.
PROCESSING_SIMULATED_WORK_MS="2000"
PROCESSING_BATCH_SIZE="5"
PROCESSING_MAX_ATTEMPTS="3"

# Liga o laco de processamento em processo. Os testes o desligam para chamar
# runProcessingCycle() diretamente e obter resultados deterministicos.
BFF_WORKER_ENABLED="true"
