{
  "ConnectionStrings": {
    "//": "Padrao de DESENVOLVIMENTO, para rodar fora do Docker. Em execucao, DATABASE_URL vence isto (ver PostgresConnectionString).",
    "Postgres": "Host=localhost;Port=5432;Database=postgres;Username=sabemi_app;Password=sabemi"
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Jwt": {
    "Secret": "troque-este-segredo-em-producao-com-no-minimo-32-caracteres",
    "Issuer": "sabemi-webhooks",
    "Audience": "sabemi-dashboard"
  },
  "Auth": {
    "MagicLinkTtl": "00:15:00",
    "OtpMaxAttempts": 5,
    "SessionTtl": "24:00:00",
    "PublicBaseUrl": "http://localhost:8080"
  },
  "Supabase": {
    "//": "GoTrue (Supabase Auth). Usado somente quando AUTH_PROVIDER=supabase. As chaves NUNCA vem daqui - este arquivo e versionado; elas vem de Supabase__Url e Supabase__AnonKey no ambiente (ver .env).",
    "Url": "",
    "AnonKey": "",
    "ServiceRoleKey": ""
  },
  "Brevo": {
    "//": "A chave NUNCA vem daqui - este arquivo e versionado. Ela vem de Brevo__ApiKey no ambiente (ver .env). Vazia = sem envio real, e o link de acesso vai para o log.",
    "ApiKey": "",
    "SenderEmail": "nao-responda@sabemi.com.br",
    "SenderName": "Sabemi"
  },
  "WebhookSecurity": {
    "ApiKey": "sabemi-dev-api-key",
    "SignatureSecret": "sabemi-dev-signature-secret",
    "RequireSignature": false,
    "ApiKeyHeader": "X-Api-Key",
    "SignatureHeader": "X-Signature"
  },
  "Processing": {
    "MaxTentativas": 3,
    "BaseRetryDelay": "00:00:05",
    "SimulatedWorkMs": 2000,
    "BatchSize": 10,
    "PollInterval": "00:00:01",
    "VisibilityTimeout": "00:02:00"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "RateLimit": {
    "AuthPermitLimit": 10,
    "AuthWindow": "00:01:00"
  }
}
