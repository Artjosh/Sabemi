# Modelo de ambiente.  cp .env.example .env
#
# Sobe uma stack funcional como está. As chaves do Supabase precisam ser
# geradas; as da Brevo, criadas na conta — sem elas o e-mail não sai, e o
# link de acesso aparece no log e na tela.
#
# Só está aqui o que é SEGREDO ou muda entre máquinas. Todo o resto — tamanho de
# lote, tentativas, portas, timeouts — tem default no código e no compose.
# Para sobrescrever qualquer um deles, veja README.md, seção "Configuração".

# ---------------------------------------------------------------------- banco
POSTGRES_PASSWORD=postgres
APP_DB_PASSWORD=sabemi

# Vazio = Postgres desta stack. Preencha com a URI para usar um Supabase remoto.
DATABASE_URL=

# ------------------------------------------------------------------- supabase
# Gateway local. Trocar por https://SEU_REF.supabase.co aponta para o remoto.
SUPABASE_URL=http://localhost:54321

# As três andam juntas. Gere com: node supabase/gerar-chaves.mjs
SUPABASE_JWT_SECRET=sabemi-supabase-jwt-secret-local-com-mais-de-32-caracteres
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------- autenticação
# `local` (magic link próprio) ou `supabase` (GoTrue emite, envia e valida).
AUTH_PROVIDER=local

# Entrega link e código OTP na resposta do login, nos DOIS backends. Vazio segue o ambiente.
AUTH_EXPOSE_LOGIN_CODES=

# Assina a sessão. Mínimo 32 caracteres, o MESMO nos dois backends.
JWT_SECRET=troque-este-segredo-em-producao-com-no-minimo-32-caracteres

# ---------------------------------------------------------------------- e-mail
# Chave da API v3 (xkeysib-...). Vazio = link de acesso vai só para o log.
BREVO_API_KEY=

# Precisa ser de um domínio VERIFICADO na Brevo, senão ela recusa com 400.
BREVO_SENDER_EMAIL=nao-responda@sabemi.com.br

# SMTP usado pelo GoTrue (chave xsmtpsib-...). Preencha os três ou nenhum.
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=

# --------------------------------------------------------- webhook (segurança)
WEBHOOK_API_KEY=sabemi-dev-api-key
WEBHOOK_SIGNATURE_SECRET=sabemi-dev-signature-secret

# Base do link de acesso do backend .NET. Vazio = `scripts/subir.mjs` detecta o IP da rede.
API_PUBLIC_URL=
# Base do painel, do link do VINEXT e da origem aceita no CORS. Vazio = detectado.
FRONTEND_PUBLIC_URL=

ASPNETCORE_ENVIRONMENT=Development

# -------------------------------------------------------------- observabilidade
# Liga o tracing. Vazio = só métricas. Use 4318 (HTTP), não 4317 (gRPC).
OTEL_EXPORTER_OTLP_ENDPOINT=
