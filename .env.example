# Copie para `.env` e ajuste. O compose funciona sem isto usando os padroes.

# ---------------------------------------------------------------- banco
POSTGRES_USER=sabemi
POSTGRES_PASSWORD=sabemi
POSTGRES_DB=sabemi
POSTGRES_PORT=5432

# ---------------------------------------------------------------- portas
API_PORT=8080
FRONTEND_PORT=3000

# ------------------------------------------------------- URLs publicas
# Precisam ser alcancaveis pelo NAVEGADOR (o link de acesso e aberto por ele,
# possivelmente em outro aparelho da rede).
API_PUBLIC_URL=http://localhost:8080
FRONTEND_PUBLIC_URL=http://localhost:3000

# ---------------------------------------------------------------- sessao
# Minimo de 32 caracteres. O MESMO valor nos dois backends: e o que permite ao
# gateway aceitar uma sessao emitida por qualquer um deles.
JWT_SECRET=troque-este-segredo-em-producao-com-no-minimo-32-caracteres

# ------------------------------------------------- seguranca do webhook
# X-Api-Key: identifica o banco parceiro.
WEBHOOK_API_KEY=sabemi-dev-api-key
# X-Signature: HMAC-SHA256 do corpo bruto. Vazio desliga a verificacao.
WEBHOOK_SIGNATURE_SECRET=sabemi-dev-signature-secret
# true exige o header X-Signature em toda chamada.
WEBHOOK_REQUIRE_SIGNATURE=false

# ------------------------------------------------------- processamento
# A regra pesada simulada (~2s) exigida pela task.
PROCESSING_SIMULATED_WORK=00:00:02
PROCESSING_SIMULATED_WORK_MS=2000
PROCESSING_BATCH_SIZE=10
PROCESSING_MAX_ATTEMPTS=3

# --------------------------------------------------------------- ambiente
ASPNETCORE_ENVIRONMENT=Development
