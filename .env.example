# =============================================================================
# TEMPLATE de ambiente.  cp .env.example .env
#
# O `.env` NAO e versionado (ver .gitignore); este arquivo e.
#
# Os valores abaixo sao os de DESENVOLVIMENTO e sobem uma stack funcional como
# estao - com uma excecao: as chaves do Supabase precisam ser geradas, e as
# credenciais da Brevo precisam ser preenchidas para o envio real de e-mail.
# Sem elas, o codigo de acesso aparece no log e na resposta do login, que e o
# suficiente para avaliar o projeto.
#
# Para PRODUCAO, troque TODOS os segredos. `docker-compose.prod.yml` se recusa a
# subir com os valores de desenvolvimento.
# =============================================================================

# -----------------------------------------------------------------------------
# BANCO — Supabase local
# -----------------------------------------------------------------------------
# O Postgres é o `supabase/postgres` (Postgres 15 + extensões da plataforma).
# Os dois backends compartilham o schema `sabemi`.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# Papel próprio da aplicação, criado por supabase/init/01-papeis-da-aplicacao.sql.
# Os backends não usam `postgres` nem `supabase_admin`.
APP_DB_USER=sabemi_app
APP_DB_PASSWORD=sabemi

# -----------------------------------------------------------------------------
# SUPABASE
# -----------------------------------------------------------------------------
# Para apontar para o Supabase REMOTO, troque apenas estas quatro linhas pelos
# valores do seu projeto (Dashboard > Settings > API) e suba a stack sem o
# arquivo `docker-compose.supabase.yml`. Nada mais muda na aplicação.
SUPABASE_URL=http://localhost:54321
SUPABASE_JWT_SECRET=sabemi-supabase-jwt-secret-local-com-mais-de-32-caracteres
SUPABASE_ANON_KEY=  # gere com: node supabase/gerar-chaves.mjs
SUPABASE_SERVICE_ROLE_KEY=  # gere com: node supabase/gerar-chaves.mjs

# Regenere as três acima com:  node supabase/gerar-chaves.mjs
# (elas andam juntas — trocar o segredo sem regenerar quebra a plataforma)

SUPABASE_PORT=54321
SUPABASE_STUDIO_PORT=54323
SUPABASE_JWT_EXPIRY=3600
SUPABASE_LOG_LEVEL=info

# Em desenvolvimento, `true` confirma o e-mail sem precisar clicar no link.
# Deixe `false` para exercitar o fluxo real de magic link.
SUPABASE_MAILER_AUTOCONFIRM=false

# -----------------------------------------------------------------------------
# E-MAIL — Brevo
# -----------------------------------------------------------------------------
# >>> PREENCHER <<<  https://app.brevo.com/settings/keys/api
#
# Sem a chave, os dois backends caem no modo de log: o link de acesso aparece
# no `docker compose logs` e na tela (em desenvolvimento). A aplicação funciona
# normalmente — só não envia e-mail de verdade.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=nao-responda@sabemi.com.br
BREVO_SENDER_NAME=Sabemi

# SMTP da Brevo, usado pelo GoTrue (o modo Supabase Auth).
# Host e porta já são os da Brevo; falta usuário e senha.
# >>> PREENCHER <<<  https://app.brevo.com/settings/keys/smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=nao-responda@sabemi.com.br
SMTP_FROM_NAME=Sabemi

# -----------------------------------------------------------------------------
# APLICAÇÃO
# -----------------------------------------------------------------------------
API_PORT=8080
FRONTEND_PORT=3000

# Precisam ser alcançáveis pelo NAVEGADOR — o link de acesso é aberto por ele,
# possivelmente de outro aparelho da rede. Para testar cross-device na LAN,
# troque `localhost` pelo IP da máquina.
API_PUBLIC_URL=http://localhost:8080
FRONTEND_PUBLIC_URL=http://localhost:3000

# Assina a sessão do painel. Mínimo de 32 caracteres, o MESMO nos dois backends
# — é o que permite ao gateway aceitar uma sessão emitida por qualquer um deles.
JWT_SECRET=troque-este-segredo-em-producao-com-no-minimo-32-caracteres

# -----------------------------------------------------------------------------
# SEGURANÇA DO WEBHOOK
# -----------------------------------------------------------------------------
# X-Api-Key: identifica o banco parceiro.
WEBHOOK_API_KEY=sabemi-dev-api-key
# X-Signature: HMAC-SHA256 do corpo bruto. Vazio desliga a verificação.
WEBHOOK_SIGNATURE_SECRET=sabemi-dev-signature-secret
# Em produção deixe `true`: a ApiKey sozinha não protege o conteúdo.
WEBHOOK_REQUIRE_SIGNATURE=false

# Pedidos de login por minuto, por IP. 10 é o valor de produção; a suíte ponta a
# ponta sobe a stack com um teto maior (ver tests/e2e/README.md).
AUTH_RATE_LIMIT=10

# -----------------------------------------------------------------------------
# PROCESSAMENTO EM BACKGROUND
# -----------------------------------------------------------------------------
# A regra pesada simulada exigida pela task. É este o tempo que o webhook NÃO
# paga: ele responde antes, e o processamento acontece em outro processo.
PROCESSING_SIMULATED_WORK=00:00:02
PROCESSING_SIMULATED_WORK_MS=2000
PROCESSING_BATCH_SIZE=10
PROCESSING_MAX_ATTEMPTS=3

# -----------------------------------------------------------------------------
# OBSERVABILIDADE
# -----------------------------------------------------------------------------
# Métricas em /metrics (Prometheus) e tracing por OTLP.
#
# ONDE FICAM AS MÉTRICAS (sempre ligadas, não dependem de nada):
#   API .NET      http://localhost:8080/metrics
#   Worker .NET   http://localhost:9464/metrics
#   BFF VINEXT    http://localhost:9465/metrics
#
# TRACING (opcional). Vazio = desligado, e a stack sobe normalmente.
# Para ligar, suba o Jaeger junto e aponte para ele:
#
#   docker compose --profile observabilidade up -d
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
#
# Interface do Jaeger: http://localhost:16686
#
# Use 4318 (OTLP/HTTP), e não 4317 (OTLP/gRPC): o backend .NET aceita os dois,
# mas o exportador do BFF só fala HTTP - com 4317 os traces do VINEXT somem em
# silêncio, porque o exportador falha em segundo plano sem derrubar nada.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAMESPACE=sabemi

ASPNETCORE_ENVIRONMENT=Development
