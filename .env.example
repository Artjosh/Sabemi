# Modelo de ambiente.  cp .env.example .env
#
# Os valores abaixo sobem uma stack funcional. As chaves do Supabase precisam
# ser geradas (node supabase/gerar-chaves.mjs); as da Brevo, criadas por você.
# Explicação de cada variável: README.md, seção "Configuração".

# ---------------------------------------------------------------------- banco
# Superusuário do Postgres. Usado só pela plataforma Supabase e pelas migrations.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# Papel da aplicação, criado por supabase/init/01-papeis-da-aplicacao.sql.
APP_DB_USER=sabemi_app
APP_DB_PASSWORD=sabemi

# Conexão dos DOIS backends. Vazio = Postgres desta stack. Preencha para remoto.
DATABASE_URL=

# ------------------------------------------------------------------- supabase
# Gateway da plataforma local. Trocar por https://SEU_REF.supabase.co usa o remoto.
SUPABASE_URL=http://localhost:54321

# As três abaixo andam juntas. Gere com: node supabase/gerar-chaves.mjs
SUPABASE_JWT_SECRET=sabemi-supabase-jwt-secret-local-com-mais-de-32-caracteres
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

SUPABASE_PORT=54321
SUPABASE_STUDIO_PORT=54323
SUPABASE_JWT_EXPIRY=3600
SUPABASE_LOG_LEVEL=info

# `true` confirma o e-mail sem clicar no link. `false` exercita o fluxo real.
SUPABASE_MAILER_AUTOCONFIRM=false

# ------------------------------------------------------------- autenticação
# `local` (magic link próprio) ou `supabase` (GoTrue emite, envia e valida).
AUTH_PROVIDER=local

# Entrega link e código na resposta. Vazio = ligado fora de produção.
AUTH_EXPOSE_LOGIN_CODES=

# Pedidos de login por minuto, por IP. A suíte E2E sobe a stack com 500.
AUTH_RATE_LIMIT=10

# Assina a sessão. Mínimo 32 caracteres, o MESMO nos dois backends.
JWT_SECRET=troque-este-segredo-em-producao-com-no-minimo-32-caracteres

# ---------------------------------------------------------------- e-mail
# PREENCHER: https://app.brevo.com/settings/keys/api — vazio = link vai só ao log.
BREVO_API_KEY=
# Precisa ser de um domínio VERIFICADO na Brevo, senão ela recusa com 400.
BREVO_SENDER_EMAIL=nao-responda@sabemi.com.br
BREVO_SENDER_NAME=Sabemi

# SMTP usado pelo GoTrue, não pelos backends. Preencha os TRÊS ou nenhum.
SMTP_HOST=
SMTP_PORT=587
# PREENCHER: https://app.brevo.com/settings/keys/smtp
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=nao-responda@sabemi.com.br
SMTP_FROM_NAME=Sabemi

# ------------------------------------------------------------------ aplicação
API_PORT=8080
FRONTEND_PORT=3000

# Precisam ser alcançáveis pelo NAVEGADOR, inclusive de outro aparelho da rede.
API_PUBLIC_URL=http://localhost:8080
FRONTEND_PUBLIC_URL=http://localhost:3000

ASPNETCORE_ENVIRONMENT=Development

# --------------------------------------------------------- webhook (segurança)
# X-Api-Key: identifica o banco parceiro.
WEBHOOK_API_KEY=sabemi-dev-api-key
# X-Signature: HMAC-SHA256 do corpo bruto. Vazio desliga a verificação.
WEBHOOK_SIGNATURE_SECRET=sabemi-dev-signature-secret
# Em produção deixe `true`: a ApiKey sozinha não protege o conteúdo.
WEBHOOK_REQUIRE_SIGNATURE=false

# ---------------------------------------------------------------- processamento
# A regra pesada simulada. É este o tempo que o webhook NÃO paga.
PROCESSING_SIMULATED_WORK=00:00:02
PROCESSING_SIMULATED_WORK_MS=2000
PROCESSING_BATCH_SIZE=10
PROCESSING_MAX_ATTEMPTS=3

# -------------------------------------------------------------- observabilidade
# Liga o tracing. Vazio = só métricas. Use 4318 (HTTP), não 4317 (gRPC).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAMESPACE=sabemi
